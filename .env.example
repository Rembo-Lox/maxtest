DATABASE_PATH=./data/app.db
BITRIX_INCOMING_TOKEN=bitrix-secret
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/webhook-code
BITRIX_TEXT_FIELD_TITLE=Текст для MAX
BITRIX_IMAGE_FIELD_TITLE=Изображение для MAX
BITRIX_RECIPIENT_FIELD_TITLE=Получатель MAX
BITRIX_STATUS_FIELD_TITLE=Статус отправки в MAX
BITRIX_RESPONDER_FIELD_TITLE=Ответил в MAX
ALLOW_RESEND=false
BITRIX_SENT_STATUS_VALUE=Отправлено
BITRIX_ACCEPTED_STATUS_VALUE=Принято
BITRIX_REJECTED_STATUS_VALUE=Отказано
MAX_BOT_TOKEN=change-me
# Только символы A-Z a-z 0-9 _ - и длина 5..256 — иначе MAX отклонит POST /subscriptions с 400.
MAX_WEBHOOK_SECRET=max-secret
MAX_API_URL=https://platform-api2.max.ru
MAX_SEND_ENABLED=false
MAX_TARGET_TYPE=chat
MAX_CHAT_ID=
# JSON: the recipient value from Bitrix24 -> the MAX chat_id for that recipient.
MAX_RECIPIENT_ROUTES={"1":"-78058901422192","2":"-78061716979824"}
REQUEST_ID_PREFIX=req_
CALLBACK_DELIMITER=:
ACCEPT_ACTION=accept
REJECT_ACTION=reject
# true: в поле "Ответил в MAX" пишется "Имя — Принято/Отказано", false: только имя.
RESPONDER_INCLUDES_RESULT=false
ACCEPT_BUTTON_TEXT=Принять
REJECT_BUTTON_TEXT=Отказать
REQUEST_TIMEOUT_SECONDS=15
